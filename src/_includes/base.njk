<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- set pageTitle = (title + " | " + site.title) if title and page.url != "/" else site.title %}
    {%- set pageDescription = (excerpt | trimText) or site.description %}
    {%- set pageImage = feature_image or "/content/images/2025/09/janus-4.jpg" %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="icon" href="/content/images/2025/09/janus-2.jpg" type="image/jpeg">
    <link rel="apple-touch-icon" sizes="180x180" href="/content/images/2025/09/janus-5.jpg">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}/rss.xml">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ pageImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.title }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.url }}{{ pageImage }}">
    <meta name="twitter:site" content="@{{ site.twitter }}">
    <meta name="author" content="Genesis Address Publishing LLC">
    <meta name="copyright" content="© 2025 Genesis Address Publishing LLC. All Rights Reserved. U.S. Copyright Registration: 1-14970280741">
    <link rel="stylesheet" href="/assets/built/screen.css">
    <link rel="stylesheet" href="/assets/css/cards.min.css">
    <link rel="stylesheet" href="/assets/css/colors.css">
    <link rel="stylesheet" href="/assets/css/genesis.css">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Book",
      "name": "The Genesis Address",
      "author": { "@type": "Organization", "name": "Genesis Address Publishing LLC" },
      "publisher": { "@type": "Organization", "name": "Genesis Address Publishing LLC", "url": "https://www.thegenesisaddress.ai/" },
      "genre": "Science Fiction",
      "description": "A science fiction thriller exploring themes of artificial intelligence and cryptocurrency deception. All content is fictional and for entertainment purposes only.",
      "copyrightYear": "2025",
      "copyrightHolder": { "@type": "Organization", "name": "Genesis Address Publishing LLC" },
      "license": "All Rights Reserved",
      "isAccessibleForFree": true,
      "audience": { "@type": "Audience", "audienceType": "Adults 18+" }
    }
    </script>
</head>
<body class="{{ bodyClass or 'paged' }} is-head-stacked has-serif-body is-head-dark">
<div class="gh-site">

    <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner gh-inner">
            <div class="gh-head-brand">
                <div class="gh-head-brand-wrapper">
                    {% if page.url == "/" %}<h1 class="gh-head-logo"><a href="/">{{ site.title }}</a></h1>{% else %}<a class="gh-head-logo" href="/">{{ site.title }}</a>{% endif %}
                </div>
                <button class="gh-burger" aria-label="Toggle menu"></button>
            </div>

            <nav class="gh-head-menu">
                <ul class="nav">
                    {%- for item in site.nav %}
                    <li class="nav-{{ item.label | lower }}{% if page.url == item.url %} nav-current{% endif %}"><a href="{{ item.url }}">{{ item.label }}</a></li>
                    {%- endfor %}
                </ul>
            </nav>

            <div class="gh-head-actions">
                <div class="gh-head-members">
                    <a class="gh-head-btn gh-btn gh-primary-btn" href="{{ site.subscribeUrl }}">Subscribe</a>
                </div>
            </div>
        </div>
    </header>

    {{ content | safe }}

    <footer class="gh-foot gh-outer">
        <div class="gh-foot-inner gh-inner">
            <section class="gh-subscribe">
                <h3 class="gh-subscribe-title">Subscribe to {{ site.title }}</h3>
                <div class="gh-subscribe-description">Get new episodes by email.</div>
                <a class="gh-subscribe-btn gh-btn" href="{{ site.subscribeUrl }}">Subscribe now</a>
            </section>

            <nav class="gh-foot-menu">
                <ul class="nav">
                    <li class="nav-sign-up"><a href="{{ site.subscribeUrl }}">Sign up</a></li>
                </ul>
            </nav>

            <div class="gh-copyright">{{ site.title }} © {{ buildYear }}</div>
        </div>
    </footer>

</div>

{% include "pswp.njk" %}

<script src="/assets/built/main.min.js"></script>

<footer class="legal-disclaimer">
  <div class="company-info">
    <div class="copyright-notice">
      © 2025 Genesis Address Publishing LLC. All Rights Reserved.
    </div>
    <p><strong>U.S. Copyright Registration:</strong> 1-14970280741</p>
    <p><strong>Publisher:</strong> Genesis Address Publishing LLC</p>
    <p><strong>Official Website:</strong> <a href="https://www.thegenesisaddress.ai/" target="_blank">www.thegenesisaddress.ai</a></p>

    <div class="contact-links">
      <a href="mailto:address.genesis.janus@gmail.com">✉ Contact</a>
      <a href="https://x.com/JanusGenesisAdd" target="_blank">𝕏 Twitter</a>
      <a href="https://instagram.com/the_genesis_address" target="_blank">📷 Instagram</a>
    </div>
  </div>
</footer>
</body>
</html>
