{% if feature_image %}
<figure class="gh-article-image">
    <img srcset="{{ feature_image | srcset }}" sizes="(max-width: 1200px) 100vw, 1200px" src="{{ feature_image | sizedImage(1200) }}" alt="{{ feature_image_alt or title }}">
    {% if feature_image_caption %}<figcaption>{{ feature_image_caption | safe }}</figcaption>{% endif %}
</figure>
{% endif %}
