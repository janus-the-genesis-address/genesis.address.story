<article class="gh-card post">
    <a class="gh-card-link" href="{{ post.url }}">
        <header class="gh-card-header">
            <h2 class="gh-card-title">{{ post.data.title }}</h2>
        </header>
        {% if post.data.excerpt %}
        <div class="gh-card-excerpt">{{ post.data.excerpt | trimText }}</div>
        {% endif %}
        <footer class="gh-card-meta">
            <time class="gh-card-date" datetime="{{ post.date | isoDay }}">{{ post.date | displayDate }}</time>
            <span class="gh-card-duration">{{ post.content | readingTime }} min read</span>
        </footer>
    </a>
</article>
