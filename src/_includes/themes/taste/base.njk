<!DOCTYPE html>
<html lang="en">
<head>
{% include "head-meta.njk" %}
    <link rel="stylesheet" href="/assets/themes/taste/built/screen.css">
    <link rel="stylesheet" href="/assets/css/fonts.css">
    <link rel="stylesheet" href="/assets/css/cards.min.css">
    <link rel="stylesheet" href="/assets/css/colors.css">
    <link rel="stylesheet" href="/assets/css/genesis.css">
    <link rel="stylesheet" href="/assets/themes/taste/genesis-theme.css">
{% include "head-schema.njk" %}
</head>
<body class="{{ bodyClass or 'paged' }} is-font-serif">
<div class="gh-site">

    <header id="gh-head" class="gh-head gh-outer is-head-middle-logo">
        <div class="gh-head-inner gh-inner">
            <div class="gh-head-brand">
                <div class="gh-head-brand-wrapper">
                    <a class="gh-head-logo" href="/">{{ site.title }}</a>
                </div>
                <button class="gh-burger" aria-label="Toggle menu"></button>
            </div>

            <nav class="gh-head-menu">
                <ul class="nav">
                    {%- for item in site.nav %}
                    <li class="nav-{{ item.label | lower }}{% if page.url == item.url or (item.also and page.url in item.also) %} nav-current{% endif %}"><a href="{{ item.url }}">{{ item.label }}</a></li>
                    {%- endfor %}
                </ul>
            </nav>

            <div class="gh-head-actions">
                <div class="gh-head-members">
                    <a class="gh-head-btn gh-btn gh-primary-btn" href="{{ site.subscribeUrl }}">Subscribe</a>
                </div>
            </div>
        </div>
    </header>

    {{ content | safe }}

    <footer class="gh-foot gh-outer">
        <div class="gh-foot-inner gh-inner">
            <div class="gh-foot-center">
                <nav class="gh-foot-menu">
                    <ul class="nav">
                        <li class="nav-sign-up"><a href="{{ site.subscribeUrl }}">Sign up</a></li>
                    </ul>
                </nav>
            </div>
            <div class="gh-copyright">{{ site.title }} © {{ buildYear }}</div>
        </div>
    </footer>

</div>

{% include "pswp.njk" %}

<script src="/assets/themes/taste/built/main.min.js"></script>
{% include "site-end.njk" %}
</body>
</html>
