---
layout: listing.njk
listingClass: genesis-media
permalink: /media/
title: Media
excerpt: "Every picture from The Genesis Address in one place, with the episode or page each one comes from. Free to view and to download at full size."
eleventyExcludeFromCollections: true
---
{%- set library = collections.posts | mediaLibrary %}
        {%- for section in library %}
        <section class="genesis-media-section" id="{{ section.slug }}">
            <h2 class="genesis-media-heading">{{ section.name }}</h2>
            {%- if section.note %}
            <p class="genesis-media-note">{{ section.note }}</p>
            {%- endif %}
            {%- for group in section.groups %}
            {%- if group.title %}
            <h3 class="genesis-media-post"><a href="{{ group.url }}">{{ group.title }}</a></h3>
            {%- endif %}
            <div class="genesis-media-grid">
                {%- for item in group.items %}
                {%- set label = item.caption or item.alt or ("Picture from " + item.home.short) %}
                <figure class="genesis-media-item">
                    <a class="genesis-media-thumb{% if item.poster %} is-poster{% endif %}" href="{{ item.src }}" title="{{ label }}" aria-label="{{ label }}" data-width="{{ item.width }}" data-height="{{ item.height }}" data-caption="{{ item.caption }}" data-sources="{{ item.sources | dump }}">
                        <img src="{{ item.src }}"{% if item.srcset %} srcset="{{ item.srcset }}" sizes="(min-width: 1100px) 190px, (min-width: 700px) 22vw, 46vw"{% endif %}{% if item.width %} width="{{ item.width }}" height="{{ item.height }}"{% endif %} alt="" loading="lazy">
                    </a>
                    {%- if not section.perPost %}
                    <figcaption class="genesis-media-label">{{ "The poster" if item.poster else item.home.short }}</figcaption>
                    {%- endif %}
                </figure>
                {%- endfor %}
            </div>
            {%- endfor %}
        </section>
        {%- endfor %}

<script>
// Opens the theme's full-screen viewer on a thumbnail, with the picture's caption, its posts and a download link.
document.addEventListener("DOMContentLoaded", function () {
  var gallery = document.querySelector(".pswp");
  var links = [].slice.call(document.querySelectorAll(".genesis-media-thumb"));
  if (!window.PhotoSwipe || !gallery || !links.length) return;
  function el(tag, props, text) {
    var node = document.createElement(tag);
    for (var key in props) node.setAttribute(key, props[key]);
    if (text) node.textContent = text;
    return node;
  }
  var items = links.map(function (link) {
    var thumb = link.querySelector("img");
    var sources = [];
    try { sources = JSON.parse(link.getAttribute("data-sources") || "[]"); } catch (e) {}
    var box = el("div");
    if (link.getAttribute("data-caption")) box.appendChild(el("div", { "class": "genesis-viewer-caption" }, link.getAttribute("data-caption")));
    var meta = el("div", { "class": "genesis-viewer-meta" });
    if (sources.length) {
      meta.appendChild(document.createTextNode(sources.length > 1 ? "Appears in " : "From "));
      sources.forEach(function (source, index) {
        if (index) meta.appendChild(document.createTextNode(", "));
        meta.appendChild(el("a", { href: source.url }, source.title));
      });
      meta.appendChild(document.createTextNode(" \u00b7 "));
    }
    meta.appendChild(el("a", { href: link.getAttribute("href"), download: "" }, "Download full size"));
    box.appendChild(meta);
    return {
      src: link.getAttribute("href"),
      msrc: thumb.currentSrc || thumb.src,
      w: parseInt(link.getAttribute("data-width"), 10) || thumb.naturalWidth || 1600,
      h: parseInt(link.getAttribute("data-height"), 10) || thumb.naturalHeight || 900,
      el: thumb,
      title: box.innerHTML
    };
  });
  links.forEach(function (link, index) {
    link.addEventListener("click", function (event) {
      event.preventDefault();
      new PhotoSwipe(gallery, PhotoSwipeUI_Default, items, {
        index: index,
        bgOpacity: 0.92,
        history: false,
        shareEl: false,
        zoomEl: false,
        fullscreenEl: false,
        closeOnScroll: false,
        getThumbBoundsFn: function (i) {
          var rect = items[i].el.getBoundingClientRect();
          return { x: rect.left, y: rect.top + (window.pageYOffset || document.documentElement.scrollTop), w: rect.width };
        }
      }).init();
    });
  });
});
</script>
