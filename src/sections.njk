---
layout: listing.njk
pagination:
  data: site.sections
  size: 1
  alias: section
permalink: "/{{ section.slug }}/"
eleventyComputed:
  title: "{{ section.name }}"
---
{%- set feedPosts = collections.posts | withTopic(section.slug) | sectionOrder(section.slug) %}
{%- if section.slug | isChannel %}
{% include "concordance-channel.njk" %}
{%- else %}
{% include "themes/" + theme + "/feed.njk" %}
{%- endif %}
