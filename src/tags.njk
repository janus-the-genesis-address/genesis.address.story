---
layout: listing.njk
pagination:
  data: collections.topics
  size: 1
  alias: topic
permalink: "/tag/{{ topic.slug }}/"
eleventyComputed:
  title: "{{ topic.name }}"
  canonical: "{{ topic.slug | sectionUrl }}"
---
{%- set feedPosts = topic.posts | sectionOrder(topic.slug) %}
{%- set largeFirst = true %}
{%- if topic.slug | isChannel %}
{% include "concordance-channel.njk" %}
{%- else %}
{% include "themes/" + theme + "/feed.njk" %}
{%- endif %}
